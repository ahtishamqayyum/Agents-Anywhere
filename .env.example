# --- Investigator (repo answers) ---
# OpenRouter:
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Or OpenAI direct:
# OPENAI_API_KEY=sk-...

# --- Audit (separate key = separate billing/account; verifies the answer) ---
OPENROUTER_AUDIT_API_KEY=sk-or-v1-REPLACE_ME_AUDIT
# Or OpenAI direct for audit only:
# OPENAI_AUDIT_API_KEY=sk-...

# If audit keys are omitted, the investigator key is reused (not independent).

# Optional: same base for both (default: OpenRouter when using OpenRouter keys)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_TITLE=Codebase Investigator

INVESTIGATOR_MODEL=openai/gpt-4o-mini
AUDIT_MODEL=openai/gpt-4o-mini
