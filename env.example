# --- Investigator (repo answers) ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# OPENAI_API_KEY=sk-...

# --- Audit (verifies answers; use a second key for independence) ---
# Strongly recommended: set this to a key from a different account/provider
# than the investigator key so the audit is independent at the credential
# layer too (not just prompt + context + programmatic checks).
OPENROUTER_AUDIT_API_KEY=sk-or-v1-REPLACE_ME_AUDIT
# OPENAI_AUDIT_API_KEY=sk-...

# --- Models ---
# Investigator does tool-calling over the cloned repo.
INVESTIGATOR_MODEL=openai/gpt-4o-mini
# For the strongest "different brain" audit signal, pick a model from a
# different family than INVESTIGATOR_MODEL (e.g. anthropic/claude-3.5-sonnet
# or google/gemini-1.5-pro). Same family still works — different prompt +
# different context + programmatic citation checks already satisfy the
# independence rule — but a different family catches more shared blind spots.
AUDIT_MODEL=anthropic/claude-3.5-sonnet